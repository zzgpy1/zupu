{
  "name": "genealogy-zupu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev .vercel/output/static --compatibility-date=2024-07-29",
    "deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:migrate": "wrangler d1 migrations apply zupu --remote"
  },
  "dependencies": {
  "@cloudflare/next-on-pages": "^1.13.17",
  "bcryptjs": "^2.4.3",
  "class-variance-authority": "^0.7.0",
  "clsx": "^2.1.0",
  "drizzle-orm": "^0.30.10",
  "jose": "^5.2.0",
  "lucide-react": "^0.309.0",
  "next": "^15.0.0",
  "react": "^18.3.0",
  "react-dom": "^18.3.0",
  "tailwind-merge": "^2.2.1"
},
"devDependencies": {
  "@cloudflare/workers-types": "^4.20240718.0",
  "@types/bcryptjs": "^2.4.6",
  "@types/node": "^20",
  "@types/react": "^18",
  "@types/react-dom": "^18",
  "autoprefixer": "^10.4.19",
  "drizzle-kit": "^0.22.4",
  "postcss": "^8.4.38",
  "tailwindcss": "^3.4.3",
  "typescript": "^5.4.5",
  "wrangler": "^3.60.0"
}
